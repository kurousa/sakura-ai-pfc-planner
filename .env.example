# さくらのAI Engine（OpenAI互換API）設定
SAKURA_AI_BASE_URL=https://api.ai.sakura.ad.jp/v1
SAKURA_AI_API_KEY=your_sakura_ai_account_token_here
SAKURA_AI_MODEL=gpt-oss-120b

# 運用ガードレール（月3,000無償枠を保護）
MONTHLY_REQUEST_LIMIT=2500
IP_DAILY_LIMIT=5
IP_MINUTE_LIMIT=1
MAX_INGREDIENTS_CHARS=2000

# SQLite保存先
SQLITE_DB_PATH=data/app.db

# Caddy本番用ドメイン（ローカル時は :80 のままでOK）
APP_DOMAIN=:80
